# ========== gitd 环境变量配置 ==========
# 复制本文件为 .env 并修改为你的实际配置

# ===== 数据库（必填）=====
# PostgreSQL 连接字符串
# 格式：postgres://用户名:密码@主机地址:端口/数据库名
POSTGRES_URL=postgres://user:password@localhost:5432/gitd
DATABASE_URL=postgres://user:password@localhost:5432/gitd

# ===== JWT 密钥（必填）=====
# 用于签发和验证登录令牌，请设置为 32 位以上的随机字符串
# 可运行 openssl rand -hex 32 生成
JWT_SECRET=请替换为随机字符串

# ===== GitHub OAuth 配置（选填，可在安装向导中配置）=====
# 从 https://github.com/settings/developers 创建 OAuth App 获取
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ===== 授权配置（选填，可在安装向导中配置）=====
# 从 https://gitd.cn 获取授权码
LICENSE_KEY=
LICENSE_VERIFY_URL=https://gitd.cn/api/license/verify
